{
  "name": "novelweb",
  "version": "0.1.0",
  "private": true,
  "description": "A local-first desktop app for managing, editing, reading, importing, and exporting Light Novels and Web Novels.",
  "type": "module",
  "main": "out/main/main.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "tsc --noEmit && electron-vite build",
    "package:dir": "npm run build && electron-builder --dir --win --x64",
    "package:win": "npm run build && electron-builder --win --x64",
    "test": "tsx --tsconfig tsconfig.test.json scripts/test-runner.ts",
    "test:pdf": "electron scripts/pdf-export-smoke.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@tiptap/react": "^3.27.1",
    "@tiptap/starter-kit": "^3.27.1",
    "jszip": "^3.10.1",
    "mammoth": "^1.12.0",
    "pdf-parse": "^2.4.5",
    "pdfjs-dist": "^6.1.200",
    "react": "^19.2.3",
    "react-dom": "^19.2.3"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.2",
    "electron": "^39.2.7",
    "electron-builder": "^26.15.3",
    "electron-vite": "^4.0.1",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "vite": "^7.3.0"
  }
}
